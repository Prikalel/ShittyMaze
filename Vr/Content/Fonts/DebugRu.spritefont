<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug SpriteFont for the aim-calibration feedback text ("нажата A / нажата B").
  Same look as the Hud font, but with Cyrillic glyph regions added (the Hud
  font only rasterizes ASCII 32..126).
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>28</Size>
    <Spacing>2</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- Cyrillic: А..я (U+0410..U+044F) + Ё (U+0401) + ё (U+0451) -->
      <CharacterRegion>
        <Start>&#1040;</Start>
        <End>&#1103;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#1025;</Start>
        <End>&#1025;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#1105;</Start>
        <End>&#1105;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
