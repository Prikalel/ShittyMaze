
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/Android
/intermediateDir:obj/Android
/platform:Android
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

# Maze textures (default set + level 2-4 sets + random floors for level 5+).
# Source files come from the Web project's content folder (read-only reuse);
# hearts and 2D first-person-weapon overlays are deliberately NOT included
# (the VR port shows HP as weapon tint and uses the 3D TT-33 model).

#begin Textures/T_Kirpich_7_BaseColor.jpg
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:../../Web/wwwroot/Content/Textures/T_Kirpich_7_BaseColor.jpg;Textures/T_Kirpich_7_BaseColor.xnb

#begin Textures/T_Wood_Floor_2_BaseColor.jpg
