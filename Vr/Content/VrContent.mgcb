# Background themes (Songs) - one per level (1..4). RISK: MP3/Song on Android
# is unproven; if the build or on-device playback fails, re-encode to WAV/OGG
# copies and reference them here (do not overwrite the Web sources).

#begin Sounds/S_main_theme1.mp3
/importer:Mp3Importer
/processor:SongProcessor
/build:../../Web/wwwroot/Content/Sounds/S_main_theme1.mp3;Sounds/S_main_theme1.xnb

#begin Sounds/S_main_theme2.mp3
/importer:Mp3Importer
/processor:SongProcessor
